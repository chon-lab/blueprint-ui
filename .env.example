# Fonte de dados da aplicação ('mock' para usar dados fictícios locais, ou 'api' para buscar do backend)
VITE_DATA_SOURCE=mock

# URL base da API (se VITE_DATA_SOURCE=api)
VITE_API_BASE_URL=/api

# IMPORTANTE: Em produção (via Docker), não modifique ou crie o .env manualmente.
# As variáveis acima devem ser cadastradas como segredos no projeto 'blueprint-ui' do ChonVault.
# O container Nginx cuidará de puxar e injetar essas variáveis dinamicamente no navegador!
